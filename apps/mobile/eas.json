{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_ADMOB_FORCE_TEST_ADS": "true",
        "EXPO_PUBLIC_ADMOB_SHOW_AD_PLACEHOLDER": "true",
        "EXPO_PUBLIC_SHOW_ROBOT_TEST_CONTROLS": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6775265578"
      }
    }
  }
}
